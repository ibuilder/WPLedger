<?xml version="1.0"?>
<ruleset name="WPLedger">
    <description>WordPress Coding Standards for WPLedger.</description>

    <!-- Scan these paths -->
    <file>includes/</file>
    <file>wpledger.php</file>
    <file>uninstall.php</file>

    <!-- Exclude generated and third-party directories -->
    <exclude-pattern>vendor/*</exclude-pattern>
    <exclude-pattern>tests/*</exclude-pattern>
    <exclude-pattern>node_modules/*</exclude-pattern>

    <!-- Use WordPress-Extra (superset of WordPress-Core + WordPress-Docs) -->
    <rule ref="WordPress-Extra" />
    <rule ref="WordPress-Docs" />

    <!-- Set minimum supported WP and PHP versions for deprecation checks -->
    <config name="minimum_supported_wp_version" value="6.0" />
    <config name="testVersion" value="8.0-" />

    <!-- Allow short array syntax -->
    <rule ref="Generic.Arrays.DisallowLongArraySyntax" />

    <!-- Relax line-length for SQL strings that must be on one line -->
    <rule ref="Generic.Files.LineLength">
        <properties>
            <property name="lineLimit" value="160" />
            <property name="absoluteLineLimit" value="0" />
        </properties>
    </rule>

    <!-- Allow the plugin-specific table-name interpolation pattern we use with phpcs:ignore -->
    <rule ref="WordPress.DB.PreparedSQL.InterpolatedNotPrepared">
        <severity>5</severity>
    </rule>
</ruleset>
